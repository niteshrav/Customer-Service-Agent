# Frontend environment template
# Copy to .env.local (or .env) for local dev.

# Use empty string to call same-origin API (with Vite proxy in dev)
VITE_API_BASE_URL=

# API port default in vite.config.js is 3101 (avoids 3000/3001)
# VITE_API_PROXY_TARGET=http://127.0.0.1:3101

# Show demo credentials on Login (matches backend npm run db:seed-demo defaults)
VITE_SHOW_DEMO_LOGIN=true
# VITE_DEMO_LOGIN_EMAIL=demo@csa.local
# VITE_DEMO_LOGIN_PASSWORD=Demo1!csa
