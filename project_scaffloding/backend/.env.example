# Copy to .env.
#
# Local Postgres without Docker (recommended): npm run db:start-local  →  port 5434, pgdata/
# DATABASE_URL=postgresql://csa:csa_local_dev@127.0.0.1:5434/customer_service_agent
#
# Or your own Postgres on 5432:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/customer_service_agent
DATABASE_URL=postgresql://csa:csa_local_dev@127.0.0.1:5434/customer_service_agent

# HTTP port (default 3101; avoids 3000/3001 conflicts)
PORT=3101
# Link shown on GET / (this server is API-only). Override if the UI is hosted elsewhere.
# PUBLIC_WEB_APP_URL=http://localhost:5173

# OpenAI key for the chatbot (`POST /api/chat`).
# Never expose this key to the frontend.
# Required if you want the chatbot to call the real model.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Optional: Qdrant Cloud RAG (when QDRANT_URL + QDRANT_API_KEY are set, RAG retrieval uses Qdrant instead of Postgres rag_document_chunks).
# Do not commit real API keys. Rotate any key that was pasted into chat or logs.
# QDRANT_URL=https://YOUR-CLUSTER.us-west-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=YOUR_QDRANT_API_KEY
# QDRANT_COLLECTION=csa_rag
# QDRANT_VECTOR_SIZE=1536
# QDRANT_PDF_PATH=../customer_service_agent_questions_answers.pdf
# QDRANT_SOURCE_ID=customer_service_agent_questions_answers
# QDRANT_SOURCE_TITLE=Customer Service Agent Q&A

# Sprint 3 — cost / caching (optional)
# LLM response cache TTL in ms (default in app: 300000 = 5 min if unset). Set to 0 to disable.
CHAT_RESPONSE_CACHE_TTL_MS=300000
# Embed / retrieval caches for RAG (defaults 120000 ms).
# CHAT_EMBED_CACHE_TTL_MS=120000
# CHAT_RETRIEVAL_CACHE_TTL_MS=120000
# CHAT_CACHE_MAX_ENTRIES=500
# Max prior messages passed to the model (default 16).
# CHAT_MAX_HISTORY_MESSAGES=16
# Max characters for the rolled-up "earlier conversation" line when history exceeds the limit (default 1500).
# CHAT_HISTORY_PRIOR_SUMMARY_MAX_CHARS=1500
# OpenAI completion token cap per chat response (default 400).
# CHAT_MAX_COMPLETION_TOKENS=400
# Per Bearer token (or per guest bucket) daily LLM token cap; 0 = unlimited.
# CHAT_DAILY_TOKEN_BUDGET_PER_KEY=0
# Protect GET /api/chat/metrics — if unset, metrics return 503.
# CHAT_METRICS_TOKEN=

# Sprint 4 — Redis caches, resilient LLM, prompt version (optional)
# If set, response/embed/retrieval caches use Redis (JSON values + TTL). Otherwise in-memory TTL caches.
# REDIS_URL=redis://127.0.0.1:6379
# Retries on transient provider errors (429/503/timeouts).
# CHAT_LLM_RETRY_MAX_ATTEMPTS=3
# CHAT_LLM_RETRY_BASE_MS=100
# CHAT_LLM_RETRY_MAX_MS=8000
# Open circuit after this many consecutive failed LLM calls (after retries).
# CHAT_CIRCUIT_FAILURE_THRESHOLD=5
# CHAT_CIRCUIT_RESET_MS=60000
# User-visible text when circuit is open or LLM fails after retries.
# CHAT_LLM_FALLBACK_MESSAGE=The assistant is temporarily unavailable. Please try again in a moment.
# Shown in the system prompt for rollout tracking.
# CHAT_PROMPT_VERSION=v1

# Optional overrides for npm run db:seed-demo
# DEMO_USER_EMAIL=demo@csa.local
# DEMO_CUSTOMER_EMAIL=demo-customer@csa.local
# DEMO_MANAGEMENT_EMAIL=demo-management@csa.local
# DEMO_USER_PASSWORD=Demo1!csa
# DEMO_USER_FULL_NAME=Demo Agent
# DEMO_CUSTOMER_ID=CUST-100
