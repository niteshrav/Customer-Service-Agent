{
  "name": "customer-service-agent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js backend for Customer Service Agent (PostgreSQL, TDD)",
  "scripts": {
    "start": "node --use-system-ca src/server.cjs",
    "db:seed-demo": "node scripts/seed-demo-user.cjs",
    "test": "node --test --test-concurrency=1 tests/db/*.test.cjs tests/seed/*.test.cjs tests/auth/*.test.cjs tests/api/*.test.cjs tests/chat/*.test.cjs",
    "verify:manual": "node scripts/verify-manual-checklist.cjs",
    "rag:ingest": "node --use-system-ca scripts/ingest-rag-corpus.cjs",
    "rag:ingest:qdrant": "node scripts/ingest-qdrant-pdf.cjs",
    "db:create-if-needed": "node scripts/create-database-if-needed.cjs",
    "db:migrate": "node src/db/run-migrations.cjs",
    "db:setup": "npm run db:create-if-needed && npm run db:migrate",
    "db:start-local": "bash scripts/start-local-pg.sh",
    "db:stop-local": "bash scripts/stop-local-pg.sh",
    "db:up": "npm run db:start-local && npm run db:migrate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@langchain/google-genai": "^2.2.0",
    "@langchain/openai": "^1.3.1",
    "@qdrant/js-client-rest": "^1.11.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "langchain": "^1.2.37",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
